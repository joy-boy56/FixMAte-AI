# NVIDIA API Configuration
# Get your API key from: https://integrate.api.nvidia.com/
NVIDIA_API_KEY=your_nvidia_api_key_here

# Server Configuration
PORT=3000

# AI Model Configuration
# Switch models here - no code changes required (restart server after editing)
AI_BASE_URL=https://integrate.api.nvidia.com/v1

# Display name shown in the UI / health endpoint
AI_PROVIDER_NAME=NVIDIA Nemotron

# "Fast" mode - quick, accurate issue detection
AI_MODEL_FAST=nvidia/nemotron-3.5-bolt-e4b
AI_MAX_TOKENS_FAST=2048

# "Max" mode - deepest reasoning, noticeably slower
AI_MODEL_MAX=nvidia/nemotron-3-ultra-550b-a55b
AI_MAX_TOKENS_MAX=4096

# Used when the primary model for a mode fails
AI_MODEL_FALLBACK=minimaxai/minimax-m3.1-flash

# Mode used when the client does not request one
AI_DEFAULT_MODE=fast
